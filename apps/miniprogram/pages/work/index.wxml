<view class="page work-page">
  <view wx:if="{{loading}}" class="empty">正在加载作业…</view>
  <view wx:elif="{{loadError}}" class="empty"><view>{{loadError}}</view><button class="button retry-button" bindtap="load">重新加载</button></view>
  <block wx:else>
    <view class="card task-card">
      <view class="task-heading">
        <view class="task-identity"><view class="title work-title">数据 {{item.itemCode}}</view></view>
        <view class="status-actions">
          <view class="tag">{{statusText}}</view>
          <button wx:if="{{canRelease}}" class="item-action-button" loading="{{releasing}}" aria-label="释放回数据池" bindtap="release"><image src="../../assets/icons/iconfont/recycle.svg" mode="aspectFit" /></button>
          <button wx:if="{{canDiscard}}" class="item-action-button danger-action" loading="{{discarding}}" aria-label="标记为无效数据" bindtap="discard"><image src="../../assets/icons/iconfont/trash.svg" mode="aspectFit" /></button>
        </view>
      </view>
      <view wx:if="{{item.currentRejection}}" class="rejection-box"><text>驳回原因：</text><text wx:for="{{item.currentRejection.reasons}}" wx:key="*this">{{item}} </text><text>{{item.currentRejection.note}}</text></view>
      <view class="reference-source">
        <view class="reference-copy-header"><view class="section-title">参考文本</view><button wx:if="{{item.referenceText}}" class="copy-reference-button" bindtap="copyReferenceText">复制全文</button></view>
        <text wx:if="{{item.referenceText}}" class="reference-text" user-select="true">{{item.referenceText}}</text>
        <view wx:else class="subtle reference-empty">无参考文本</view>
      </view>
      <view class="reference-source">
        <view class="section-title">参考音频</view>
        <audio-player wx:if="{{referenceAudioPath}}" class="reference-player" src="{{referenceAudioPath}}" label="参考音频" duration-millis="0" binddurationchange="referenceAudioDurationChange" binderror="referenceAudioPlaybackError" />
        <view wx:else class="subtle reference-empty">无参考音频</view>
      </view>
      <view class="reference-source">
        <view class="section-title">参考视频</view>
        <video wx:if="{{referenceVideoPath}}" class="media" src="{{referenceVideoPath}}" controls bindloadedmetadata="referenceVideoLoadedMetadata" binderror="videoPlaybackError" />
        <view wx:else class="subtle reference-empty">无参考视频</view>
      </view>
    </view>

    <view wx:if="{{editable}}" class="card recorder-card">
      <view class="recorder-stage">
        <view wx:if="{{recordState==='idle'||recordState==='error'}}" class="recorder-state idle-state">
          <button class="mic-button" aria-label="开始录音" bindtap="startRecord"><image src="../../assets/icons/iconfont/microphone.svg" mode="aspectFit" /></button>
          <view class="recorder-hint">点击开始录音</view>
        </view>

        <view wx:elif="{{recordState==='recording'||recordState==='paused'}}" class="recorder-state active-state">
          <view class="recording-status"><view class="status-dot {{recordState==='paused'?'paused':''}}"></view><text>{{recordState==='paused'?'已暂停':'录音中'}}</text></view>
          <view class="recording-duration">{{recordingDurationText}}</view>
          <view class="wave"><view wx:for="{{levelBars}}" wx:key="index" class="wave-bar" style="height:{{recordState==='paused'?8:item}}rpx" /></view>
          <view class="record-actions">
            <button wx:if="{{recordState==='recording'}}" class="record-control" bindtap="pauseRecord"><image src="../../assets/icons/iconfont/pause.svg" mode="aspectFit" /><text>暂停</text></button>
            <button wx:else class="record-control" bindtap="resumeRecord"><image src="../../assets/icons/iconfont/resume.svg" mode="aspectFit" /><text>继续</text></button>
            <button class="record-control stop-control" bindtap="stopRecord"><image src="../../assets/icons/iconfont/stop.svg" mode="aspectFit" /><text>结束</text></button>
          </view>
        </view>

        <view wx:elif="{{recordState==='stopping'}}" class="recorder-state processing-state"><view class="processing-ring"></view><view class="recorder-hint">正在生成音频…</view></view>

        <view wx:elif="{{audioPath&&recordState==='stopped'}}" class="recorder-state completed-state">
          <audio-player src="{{audioPath}}" label="录制音频" duration-millis="{{audioDuration}}" binderror="audioPlaybackError" />
          <view class="recording-result-actions">
            <button class="rerecord-button" bindtap="startRecord">重新录制</button>
            <button class="delete-recording-button" bindtap="deleteRecording"><image src="../../assets/icons/iconfont/trash.svg" mode="aspectFit" />删除录音</button>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{readOnly}}" class="card readonly-result">
      <audio-player wx:if="{{audioPath}}" src="{{audioPath}}" label="已提交录音" duration-millis="{{audioDuration}}" binderror="audioPlaybackError" />
      <view wx:else class="subtle">暂无可播放录音</view>
    </view>

    <view wx:if="{{configuration.resultType==='TEXT'&&editable}}" class="card"><view class="section-title">文本结果</view><view class="result-hint">文本或录音至少提交一项，也可以同时提交</view><textarea class="textarea work-textarea" maxlength="-1" placeholder="请输入文本" value="{{text}}" bindinput="textInput" /></view>
    <view wx:if="{{configuration.resultType==='TEXT'&&readOnly}}" class="card"><view class="section-title">文本结果</view><view class="readonly-text">{{text||'暂无文本'}}</view></view>
    <view wx:if="{{isDiscarded}}" class="card discard-detail">
      <view class="section-title">无效数据记录</view>
      <view class="discard-row"><text>原因</text><text>{{item.currentDiscard.reason||'历史废弃记录（无备注）'}}</text></view>
      <view class="discard-row"><text>操作人</text><text>{{item.currentDiscard.actorName||item.currentDiscard.actorUserId||'-'}}</text></view>
      <view class="discard-row"><text>操作时间</text><text>{{discardedAtText}}</text></view>
      <button class="button restore-button" loading="{{restoring}}" disabled="{{restoring}}" bindtap="restore">恢复数据</button>
    </view>
    <view wx:if="{{editable}}" class="card submit-card">
      <view wx:if="{{showAutoClaimNext}}" class="auto-next-row"><view><view class="auto-next-title">提交后自动领取下一条</view><view class="subtle">提交成功后直接进入下一条作业</view></view><switch class="capsule-switch" checked="{{autoClaimNextEnabled}}" color="#2563eb" bindchange="autoClaimNextChange" /></view>
      <button class="button submit-button" loading="{{submitting}}" disabled="{{submitting||recordState==='recording'||recordState==='paused'||recordState==='stopping'}}" bindtap="submit">{{submitLabel}}</button>
    </view>
  </block>
</view>
