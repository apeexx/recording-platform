.statistics-page{padding-bottom:calc(48rpx + env(safe-area-inset-bottom))}.report-heading{background:linear-gradient(135deg,#eff6ff,#fff)}.eyebrow{color:#64748b;font-size:24rpx;margin-bottom:12rpx}.task-picker{display:flex;align-items:center;justify-content:space-between;font-size:34rpx;font-weight:700}.metric-grid{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.metric-card{margin:0;text-align:center;padding:26rpx 16rpx}.metric-card.primary{background:#eef5ff}.metric-card.wide{grid-column:1/-1}.metric-duration{font-size:30rpx;line-height:1.35}.metric-label{margin-top:10rpx;color:#64748b;font-size:24rpx}.section-heading{display:flex;align-items:end;justify-content:space-between;margin:36rpx 0 18rpx}.section-title{font-size:34rpx;font-weight:700}.day-card{padding:24rpx}.day-top{display:flex;align-items:center;justify-content:space-between}.day-date{font-weight:700}.day-count{color:#2563eb;font-weight:700}.day-metrics{display:flex;flex-wrap:wrap;gap:12rpx 22rpx;margin-top:16rpx;color:#64748b;font-size:24rpx}.more-link{color:#2563eb;padding:10rpx}.submission-card{position:relative;padding-right:72rpx}.submission-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:12rpx}.submission-code{font-weight:700}.submission-card .chevron{position:absolute;right:24rpx;top:50%;transform:translateY(-50%);font-size:46rpx;color:#94a3b8}.empty.compact{padding:44rpx 20rpx}
