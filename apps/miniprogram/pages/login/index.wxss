.login-page{min-height:100vh;box-sizing:border-box;padding:88rpx 44rpx 64rpx;background:#f7f5f1;text-align:center}.brand-title{font-size:48rpx;font-weight:750;color:#29221d}.brand-mark{width:132rpx;height:132rpx;margin:28rpx auto 26rpx;border-radius:38rpx;overflow:hidden;box-shadow:0 16rpx 45rpx rgba(75,55,40,.1)}.brand-mark image{width:132rpx;height:132rpx}.brand-slogan{font-size:32rpx;font-weight:650;color:#493a30}.brand-copy{margin:14rpx 0 28rpx;color:#84776d;font-size:27rpx}.audience-notice{box-sizing:border-box;margin:0;padding:24rpx 26rpx;border:1rpx solid #e5d8c9;border-radius:20rpx;background:#fffaf3;text-align:left}.audience-notice-title{color:#493a30;font-size:28rpx;font-weight:700}.audience-notice-copy{margin-top:10rpx;color:#76685d;font-size:24rpx;line-height:1.7}.login-card{margin-bottom:24rpx;text-align:left;background:#fff;border:1rpx solid #ebe5dd;border-radius:30rpx;padding:38rpx 34rpx;box-shadow:0 24rpx 60rpx rgba(75,55,40,.08)}.mode-header{display:flex;align-items:flex-start;justify-content:space-between;gap:20rpx}.mode-title{font-size:36rpx;font-weight:700}.mode-copy{color:#8b8178;font-size:25rpx;margin:12rpx 0 28rpx}.switch{flex:none;color:#765442;font-size:25rpx;line-height:44rpx}.login-input{height:88rpx;box-sizing:border-box;width:100%;padding:0 28rpx;border:1rpx solid #ded6ce;border-radius:18rpx;background:#fcfbf9;font-size:28rpx}.login-input+.login-input{margin-top:20rpx}.wechat-button,.account-button{height:96rpx;border-radius:20rpx;color:#fff;font-weight:650;display:flex;align-items:center;justify-content:center}.wechat-button{background:#07c160}.wechat-button image{width:44rpx;height:44rpx;margin-right:18rpx}.account-button{background:#765442;margin-top:28rpx}.invitation-backdrop{position:fixed;inset:0;z-index:1000;display:flex;align-items:center;justify-content:center;box-sizing:border-box;padding:44rpx;background:rgba(41,34,29,.46)}.invitation-dialog{width:100%;box-sizing:border-box;padding:38rpx 34rpx;border-radius:30rpx;background:#fff;text-align:left;box-shadow:0 30rpx 90rpx rgba(41,34,29,.2)}.invitation-title{font-size:36rpx;font-weight:700;color:#29221d}.invitation-copy{margin:14rpx 0 28rpx;color:#76685d;font-size:25rpx;line-height:1.6}.invitation-input{text-transform:uppercase}.invitation-actions{display:grid;grid-template-columns:1fr 1.25fr;gap:20rpx;margin-top:28rpx}.invitation-actions button{box-sizing:border-box;width:100%;min-width:0;height:82rpx;margin:0;padding:0 16rpx;line-height:82rpx;border-radius:18rpx;font-size:26rpx;white-space:nowrap}.invitation-cancel{background:#f4f0eb;color:#493a30}.invitation-submit{background:#765442;color:#fff}.error{color:#b64a45;margin-top:22rpx;font-size:25rpx}
