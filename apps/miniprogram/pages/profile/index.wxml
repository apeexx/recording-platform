<view class="page">
  <view class="card profile-card" bindtap="openSettings"><image class="profile-avatar" src="{{avatarSrc}}"/><view class="profile-copy"><view class="title">{{user.name||'录音人员'}}</view><view class="profile-state {{user.profileComplete?'complete':''}}">资料状态：{{user.profileComplete?'已完善':'待完善'}}</view></view><view class="chevron">›</view></view>
  <view class="card settings-card" bindtap="openSettings"><view><view class="settings-title">个人资料与账号</view><view class="subtle">修改姓名、头像、数字账号或密码</view></view><view class="chevron">›</view></view>
  <button class="button secondary" bindtap="logout">退出登录</button>
</view>
